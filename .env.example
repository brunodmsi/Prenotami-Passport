# Copy this file to .env and fill in your values. Never commit .env.

# --- Prenotami credentials ------------------------------------------------
PRENOTAMI_EMAIL=your.email@example.com
PRENOTAMI_PASSWORD=your-password

# Which appointment row to monitor on the "Prenotazioni" table.
# 1 = passport, 2 = citizenship (matches the original script's behaviour).
# Override if your consulate lists services in a different order.
APPOINTMENT_SERVICE_ROW=1

# --- Polling behaviour ----------------------------------------------------
# Minimum and maximum delay between availability checks, in seconds.
# A random value in [min, max] is picked every iteration to avoid a fixed
# cadence that makes the client easy to fingerprint. Defaults err on the
# polite side; lowering these too far is the fastest way to get IP-banned.
POLL_MIN_SECONDS=300
POLL_MAX_SECONDS=900

# Re-login every N checks. Long-lived sessions look more human than a fresh
# login on every poll, but the site does eventually expire them.
RELOGIN_EVERY=20

# After this many consecutive errors the browser is torn down and restarted
# with a fresh profile. Keeps transient failures from wedging the process.
MAX_CONSECUTIVE_ERRORS=5

# --- Stealth / browser fingerprint ---------------------------------------
# Headless is easier to host but slightly more detectable. Set HEADLESS=false
# when developing locally so you can see what's happening.
HEADLESS=true

# Locale and timezone reported to the site. Match these to the account's
# real location to avoid a trivial tell.
BROWSER_LOCALE=it-IT
BROWSER_TIMEZONE=Europe/Rome

# --- Optional: proxy for IP rotation -------------------------------------
# Residential proxies work best; datacenter IPs are frequently blocked.
# Leave empty to connect directly.
# PROXY_SERVER=http://user:pass@proxy.example.com:8000

# --- Optional: Telegram notifications ------------------------------------
# Leave TELEGRAM_BOT_TOKEN empty to disable Telegram entirely (checks still
# run, results go to the log). Get a token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs to notify. Send /start to your bot, then check
# https://api.telegram.org/bot<token>/getUpdates to find your chat id.
TELEGRAM_CHAT_IDS=

# --- Logging -------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
