# Copy this file to .env and fill in your values. Never commit .env.
#
# Secrets-from-files: every variable below also accepts a `<NAME>_FILE`
# variant whose value is a path to a file containing the secret. The file
# path wins if both are set. Trailing whitespace is stripped, so you can
# point it directly at agenix / sops / Docker secrets / systemd
# LoadCredential outputs without worrying about trailing newlines. Example:
#   PRENOTAMI_PASSWORD_FILE=/run/agenix/prenotami-password
# See DEPLOYMENT.md for the systemd + agenix recipe.

# --- Prenotami credentials ------------------------------------------------
PRENOTAMI_EMAIL=your.email@example.com
PRENOTAMI_PASSWORD=your-password

# Which appointment row to monitor on the "Prenotazioni" table.
# 1 = passport, 2 = citizenship (matches the original script's behaviour).
# Override if your consulate lists services in a different order.
APPOINTMENT_SERVICE_ROW=1

# --- Polling behaviour ----------------------------------------------------
# Minimum and maximum delay between availability checks, in seconds.
# A random value in [min, max] is picked every iteration to avoid a fixed
# cadence that makes the client easy to fingerprint.
#
# Default preset: ~1 check per hour (55–70 min jitter). Polite enough for
# long unattended runs from a single home IP, which is the only regime
# where running without a residential proxy is realistic.
# If you tighten these below ~900 expect to be rate-limited within hours.
POLL_MIN_SECONDS=3300
POLL_MAX_SECONDS=4200

# Re-login every N checks. At ~1/hour this is roughly every 12 hours —
# long enough that the session cookie stays fresh, short enough that a
# silently-expired session gets refreshed before it wastes many polls.
RELOGIN_EVERY=12

# After this many consecutive errors the poll loop surrenders and the
# runner either exits (hit the restart ceiling) or tears down the browser
# and tries again with a fresh profile. Low on purpose: when the site
# starts returning block pages, the right move is to stop hammering it.
MAX_CONSECUTIVE_ERRORS=3

# --- Stealth / browser fingerprint ---------------------------------------
# Headless is easier to host but slightly more detectable. Set HEADLESS=false
# when developing locally so you can see what's happening.
HEADLESS=true

# Locale and timezone reported to the site. Match these to the account's
# real location to avoid a trivial tell.
BROWSER_LOCALE=it-IT
BROWSER_TIMEZONE=Europe/Rome

# --- Optional: proxy for IP rotation -------------------------------------
# Residential proxies work best; datacenter IPs are frequently blocked.
# Leave empty to connect directly.
# PROXY_SERVER=http://user:pass@proxy.example.com:8000

# --- Optional: Telegram notifications ------------------------------------
# Leave TELEGRAM_BOT_TOKEN empty to disable Telegram entirely (checks still
# run, results go to the log). Get a token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs to notify. Send /start to your bot, then check
# https://api.telegram.org/bot<token>/getUpdates to find your chat id.
TELEGRAM_CHAT_IDS=

# Ping Telegram on every "no slots" result too, not just the first one.
# At ~1 check/hour this is 24+ messages/day — off by default. Useful for
# the first day while you're confirming everything works; turn it off
# once you trust the pipeline.
NOTIFY_EVERY_CHECK=false

# --- Logging -------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
