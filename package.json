{
  "name": "prenotami",
  "version": "1.1.0",
  "private": true,
  "description": "Automated availability checker for Prenotami (Italian consulate) passport & citizenship appointments",
  "keywords": [
    "prenotami",
    "passport",
    "italy",
    "playwright",
    "automation"
  ],
  "license": "ISC",
  "author": "constantini",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "rimraf dist && swc src -d dist",
    "start": "npm run build && node dist/src/index.js",
    "dev": "nodemon --ext ts --exec \"npm run build && node dist/src/index.js\"",
    "debug": "npm run build && node --inspect dist/src/index.js",
    "printPage": "npm run build && node dist/src/print-page.js",
    "install-browsers": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "playwright": "^1.48.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@swc/cli": "^0.4.1-nightly.20240914",
    "@swc/core": "^1.7.39",
    "@types/node": "^22.7.8",
    "nodemon": "^3.1.7",
    "rimraf": "^6.0.1",
    "sort-package-json": "^2.10.1",
    "typescript": "^5.6.3"
  }
}
